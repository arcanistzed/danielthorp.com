---
import { profiles } from "../data/social";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<ul class="profiles" role="list" aria-label="Elsewhere">
		{
			profiles.map(link => {
				const Icon = link.icon;
				return (
					<li>
						<a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.aria} title={link.label}>
							<Icon />
						</a>
					</li>
				);
			})
		}
	</ul>
	<p class="fine-print">
		&copy; {year} Daniel Thorp
		<span aria-hidden="true">·</span>
		Views are my own
		<span aria-hidden="true">·</span>
		<a href="https://github.com/arcanistzed/danielthorp.com" target="_blank" rel="noopener noreferrer">
			Source on GitHub<span class="sr-only"> (opens in new tab)</span>
		</a>
	</p>
</footer>

<style>
	.profiles {
		display: flex;
		justify-content: center;
		gap: var(--space-2);
		margin: 0 0 var(--space-3);
		padding: 0;
		list-style: none;
	}

	.profiles a {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		color: var(--color-muted);
		transition:
			color var(--dur-2),
			background-color var(--dur-2);
	}

	.profiles a:hover,
	.profiles a:focus-visible {
		color: var(--color-text);
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
	}

	.profiles :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
	}

	.fine-print {
		font-size: 0.85rem;
		text-wrap: balance;
	}

	.fine-print span[aria-hidden] {
		margin: 0 0.4em;
	}

	.fine-print a {
		color: inherit;
		text-underline-offset: 3px;
	}

	.fine-print a:hover {
		color: var(--color-text);
	}
</style>
