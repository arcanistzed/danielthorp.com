---
import { areas, leadership, work, type Role } from "../../data/experience";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// "May 2025 to Aug 2025" -> 2025.33, the fractional year a role started.
function started(dates: string): number {
	const [month, year] = dates.split(/\s+to\s+/)[0].trim().split(/\s+/);
	return Number(year) + Math.max(0, MONTHS.indexOf(month)) / 12;
}

// Each role's filter group: employment, or what the volunteering was about.
type Entry = Role & { group: string; start: number };
const entries: Entry[] = [
	...work.map(role => ({ ...role, group: "employment" })),
	...leadership.map(role => ({ ...role, group: role.area as string })),
]
	.map(role => ({ ...role, start: started(role.dates) }))
	.sort((a, b) => b.start - a.start);

const years = [...new Set(entries.map(entry => Math.floor(entry.start)))];
---

<section class="flat experience" id="experience" aria-labelledby="experience-title" data-bed="tree" data-sfx="wood">
	<div class="flat-inner">
		<h2 id="experience-title">Experience</h2>
		<div class="filters" role="group" aria-label="Show">
			<button type="button" data-filter="all" aria-pressed="true">All</button>
			<button type="button" data-filter="employment" aria-pressed="false">Employment</button>
			{
				areas.map(([id, label]) => (
					<button type="button" data-filter={id} aria-pressed="false">
						{label}
					</button>
				))
			}
		</div>

		<div class="timeline">
			{
				years.map(year => (
					<div class="year">
						<h3 class="year-label">{year}</h3>
						<ul class="roles" role="list">
							{entries
								.filter(entry => Math.floor(entry.start) === year)
								.map(role => (
									<li data-group={role.group}>
										<details class="role">
											<summary>
												<span class="role-head">
													<span class="role-title">{role.title}</span>
													<span class="role-org">{role.org}</span>
												</span>
												<span class="role-dates">{role.dates}</span>
												<svg class="role-caret" viewBox="0 0 24 24" aria-hidden="true">
													<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
												</svg>
											</summary>
											<ul class="points">
												{role.points.map(point => (
													<li>{point}</li>
												))}
											</ul>
										</details>
									</li>
								))}
						</ul>
					</div>
				))
			}
		</div>

	</div>
</section>

<script>
	import { drawer, knock, milestone, scribe } from "../../scripts/sound";

	const section = document.getElementById("experience")!;
	const filters = [...section.querySelectorAll<HTMLButtonElement>(".filters button")];
	for (const button of filters) {
		button.addEventListener("click", () => {
			const group = button.dataset.filter;
			for (const other of filters) other.setAttribute("aria-pressed", String(other === button));
			for (const item of section.querySelectorAll<HTMLElement>(".timeline li[data-group]")) {
				item.hidden = group !== "all" && item.dataset.group !== group;
			}
			for (const year of section.querySelectorAll<HTMLElement>(".timeline .year")) {
				year.hidden = !year.querySelector("li[data-group]:not([hidden])");
			}
			knock();
		});
	}

	// The rail fills to a line 60% of the way down the screen. Each year's bulb
	// fills from the top as the liquid passes through it (--level), and the
	// year counts as reached once the liquid is at the bulb's centre.
	const timeline = section.querySelector<HTMLElement>(".timeline")!;
	const years = [...timeline.querySelectorAll<HTMLElement>(".year")];
	let fillFrame = 0;
	let lastDepth = 0;
	let settled = false;
	function fill() {
		fillFrame = 0;
		const box = timeline.getBoundingClientRect();
		const depth = Math.min(Math.max(window.innerHeight * 0.6 - box.top, 0), box.height);
		timeline.style.setProperty("--fill", `${depth}px`);
		const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
		const dotOffset = parseFloat(getComputedStyle(timeline).getPropertyValue("--dot-top")) * rem;
		// The line scratches as it draws, and each year rings as the rail
		// reaches its dot; not on the first layout, and not for hidden years.
		if (settled && depth !== lastDepth) scribe(Math.abs(depth - lastDepth));
		lastDepth = depth;
		const radius = parseFloat(getComputedStyle(timeline).getPropertyValue("--bulb")) / 2;
		// Several dots can be reached in one frame, as on a long jump or when a
		// filter brings years back below a rail that already passes them; their
		// bells cascade a beat apart instead of landing together.
		let burst = 0;
		years.forEach((year, index) => {
			const shown = year.offsetParent !== null;
			const centre = year.offsetTop + dotOffset;
			const level = Math.min(Math.max((depth - (centre - radius)) / (2 * radius), 0), 1);
			year.style.setProperty("--level", String(shown ? level : 0));
			const reached = shown && centre <= depth;
			const was = year.classList.contains("reached");
			year.classList.toggle("reached", reached);
			if (settled && shown && reached !== was) {
				const delay = reached ? burst++ * 140 : 0;
				if (delay) setTimeout(() => milestone(index, reached), delay);
				else milestone(index, reached);
			}
		});
		settled = true;
	}
	const queueFill = () => {
		if (!fillFrame) fillFrame = requestAnimationFrame(fill);
	};
	window.addEventListener("scroll", queueFill, { passive: true });
	window.addEventListener("resize", queueFill);
	for (const button of filters) button.addEventListener("click", queueFill);
	fill();

	// Hovering a summary is covered by the shared interaction sounds.
	for (const details of document.querySelectorAll<HTMLDetailsElement>("details.role")) {
		details.addEventListener("toggle", () => drawer(details.open));
	}
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}


	/* The section is a workbench (see sections.css): brass for the fittings,
	   amber in the glass. */
	.experience {
		--brass: #d4a75a;
		--brass-hi: #f0d08e;
		--brass-lo: #94692a;
		--engrave: 0 1px 0 rgba(0, 0, 0, 0.55);
		--year: var(--brass-hi);
		--card: rgba(0, 0, 0, 0.16);
		--drawer: rgba(0, 0, 0, 0.3);
		--drawer-shadow: inset 0 2px 7px rgba(0, 0, 0, 0.45);
	}

	:global(:root[data-theme="light"]) .experience {
		--brass: #9a6b22;
		--brass-hi: #c89a48;
		--brass-lo: #6c4812;
		--engrave: 0 1px 0 rgba(255, 255, 255, 0.6);
		--year: var(--brass-lo);
		--card: rgba(255, 249, 238, 0.6);
		--drawer: rgba(255, 249, 238, 0.88);
		--drawer-shadow: inset 0 2px 6px rgba(90, 60, 25, 0.16);
	}

	/* A brass rule under the heading, one of the bench's fittings. */
	.experience h2 {
		padding-bottom: var(--space-3);
		border-bottom: 1px solid color-mix(in srgb, var(--brass) 85%, transparent);
	}

	/* Filters are small brass tags; the selected one is polished. */
	.filters button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35em 0.9em;
		border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
		border-radius: 4px;
		background: color-mix(in srgb, var(--brass) 8%, transparent);
		color: var(--color-text);
		cursor: pointer;
		transition:
			background-color var(--dur-2),
			border-color var(--dur-2);
	}

	.filters button:hover {
		border-color: var(--brass);
	}

	.filters button[aria-pressed="true"] {
		background: linear-gradient(to bottom, var(--brass-hi), var(--brass) 55%, var(--brass-lo));
		border-color: var(--brass-lo);
		color: #2a1a0c;
		text-shadow: 0 1px 0 rgba(255, 240, 210, 0.45);
	}

	/* On maple the darker light-mode brass is too dark under dark text, so the
	   selected tag uses pale polished brass instead. */
	:global(:root[data-theme="light"]) .filters button[aria-pressed="true"] {
		background: linear-gradient(to bottom, #f6e2b0, #e3c07a 55%, #c99c52);
		border-color: #a77a33;
	}

	/* A glass tube down the left with the year each group of roles started.
	   Liquid runs down it as you scroll, and at each year the tube widens into
	   a bulb that fills from the top as the liquid passes through. Layers, back
	   to front: the tube, the liquid in it, each bulb's glass (which hides the
	   tube's liquid inside it), then the bulb's own liquid. */
	.timeline {
		--rail: 3.1rem;
		--gutter: 4.5rem;
		--dot-top: 1.2rem;
		--fill: 0px;
		--tube: 6px;
		--bulb: 18px;
		--liquid: #f0a531;
		--liquid-deep: #cf7a16;
		--glass: color-mix(in srgb, #fff 7%, var(--bg-experience));
		--glass-edge: rgba(255, 255, 255, 0.28);
		--glint: inset 1.5px 0 0 rgba(255, 255, 255, 0.22);
		position: relative;
		isolation: isolate;
		padding-left: var(--gutter);
	}

	:global(:root[data-theme="light"]) .timeline {
		--liquid: #d98a1c;
		--liquid-deep: #b0620c;
		--glass: color-mix(in srgb, #fff 45%, var(--bg-experience));
		--glass-edge: rgba(90, 60, 25, 0.35);
	}

	.timeline::before,
	.timeline::after {
		content: "";
		position: absolute;
		top: 0;
		left: var(--rail);
		translate: -50% 0;
	}

	.timeline::before {
		z-index: 0;
		bottom: 0;
		width: var(--tube);
		border: 1px solid var(--glass-edge);
		border-radius: var(--tube);
		background: var(--glass);
		box-shadow: var(--glint);
		box-sizing: border-box;
	}

	.timeline::after {
		z-index: 1;
		height: var(--fill);
		width: calc(var(--tube) - 2px);
		border-radius: 0 0 var(--tube) var(--tube);
		background: var(--liquid);
	}

	.year {
		--level: 0;
		position: relative;
		margin-bottom: var(--space-5);
	}

	.year[hidden] {
		display: none;
	}

	.year::before,
	.year::after {
		content: "";
		position: absolute;
		left: calc(var(--rail) - var(--gutter));
		top: var(--dot-top);
		translate: -50% -50%;
		border-radius: 50%;
		box-sizing: border-box;
	}

	/* The bulb's glass, drawn over the tube so the two read as one vessel. */
	.year::before {
		z-index: 2;
		width: var(--bulb);
		height: var(--bulb);
		border: 1px solid var(--glass-edge);
		background: var(--glass);
		box-shadow: var(--glint);
	}

	/* The liquid inside the bulb, filled to --level from the top, and a
	   little deeper in colour where the vessel is wider. */
	.year::after {
		z-index: 3;
		width: calc(var(--bulb) - 3px);
		height: calc(var(--bulb) - 3px);
		background: linear-gradient(
			to bottom,
			var(--liquid-deep) calc(var(--level) * 100%),
			transparent calc(var(--level) * 100%)
		);
		transition: box-shadow 400ms ease;
	}

	.year.reached::after {
		box-shadow: 0 0 10px color-mix(in srgb, var(--liquid) 45%, transparent);
	}

	/* The year sits just left of its bulb, centred on it. */
	.year .year-label {
		position: absolute;
		right: calc(100% - (var(--rail) - var(--gutter)) + var(--bulb) / 2 + 0.6rem);
		top: var(--dot-top);
		translate: 0 -50%;
		margin: 0;
		line-height: 1;
		white-space: nowrap;
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: var(--year);
		text-shadow: var(--engrave);
		text-align: right;
	}

	.roles {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.roles > li[hidden] {
		display: none;
	}

	/* An open role pulls out like a drawer: the title and its points sit in
	   one shallow recess in the bench, edged in brass down the left. The edge
	   is always there (transparent when closed) so nothing shifts on opening. */
	/* Each role is a card on the bench, a little apart from the next, with a
	   backing solid enough that the grain never runs behind the text. */
	.roles > li + li {
		margin-top: var(--space-2);
	}

	.role {
		border-left: 2px solid transparent;
		border-radius: 6px;
		background: var(--card);
		transition:
			background-color var(--dur-2),
			border-color var(--dur-2);
	}

	.role[open] {
		border-left-color: var(--brass);
		background: var(--drawer);
		box-shadow: var(--drawer-shadow);
	}

	summary {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-3) var(--space-2);
		cursor: pointer;
		list-style: none;
		border-radius: 6px;
		transition: background-color var(--dur-2);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		background: color-mix(in srgb, var(--brass) 10%, transparent);
	}

	.role-head {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}

	.role-title {
		font-weight: 600;
	}

	.role-org {
		color: var(--color-muted);
	}

	.role-dates {
		font-size: 0.85rem;
		color: var(--color-muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	/* A brass knob that turns as the role opens. */
	.role-caret {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--brass);
		transition: transform 320ms cubic-bezier(0.3, 0, 0.2, 1);
	}

	details[open] .role-caret {
		transform: rotate(180deg);
	}

	/* The points line up with the title above, each marked with a brass stud. */
	.points {
		margin: 0;
		padding: var(--space-1) var(--space-4) var(--space-3) calc(var(--space-2) + 1.1rem);
		list-style: none;
	}

	.points li {
		position: relative;
		max-width: 68ch;
		margin-bottom: var(--space-2);
		line-height: 1.55;
	}

	.points li::before {
		content: "";
		position: absolute;
		left: -1.05rem;
		top: 0.55em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, var(--brass-hi), var(--brass) 55%, var(--brass-lo));
		box-shadow: 0 1px 1px rgba(0, 0, 0, 0.35);
	}

	@media (max-width: 640px) {
		/* A slim rail at the left edge, with the year above its roles. */
		.timeline {
			--rail: 0.5rem;
			--gutter: 1.6rem;
			--dot-top: 0.7rem;
		}

		.year .year-label {
			position: static;
			translate: none;
			line-height: inherit;
			margin: 0 0 var(--space-1);
			padding-left: var(--space-2);
			text-align: left;
		}

		summary {
			grid-template-columns: 1fr auto;
			gap: var(--space-2) var(--space-3);
		}

		.role-dates {
			grid-column: 1;
			grid-row: 2;
		}

		.role-caret {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}
</style>
