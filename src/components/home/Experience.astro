---
import { leadership, work, type Role } from "../../data/experience";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const now = new Date();
const NOW = now.getFullYear() + now.getMonth() / 12;

// "May 2025 to Aug 2025", "Apr 2025", "Nov 2022 to present" -> fractional years.
function span(dates: string): [number, number] {
	const parse = (part: string) => {
		if (/present/i.test(part)) return NOW;
		const [month, year] = part.trim().split(/\s+/);
		return Number(year) + Math.max(0, MONTHS.indexOf(month)) / 12;
	};
	const [from, to] = dates.split(/\s+to\s+/);
	const start = parse(from);
	const end = to ? parse(to) : start;
	return [start, Math.max(end + 1 / 12, start + 1 / 12)];
}

type Entry = Role & { kind: "work" | "leadership"; start: number; end: number };
const entries: Entry[] = [
	...work.map(role => ({ ...role, kind: "work" as const })),
	...leadership.map(role => ({ ...role, kind: "leadership" as const })),
]
	.map(role => {
		const [start, end] = span(role.dates);
		return { ...role, start, end };
	})
	.sort((a, b) => b.start - a.start);

const years = [...new Set(entries.map(entry => Math.floor(entry.start)))];
---

<section class="flat experience" id="experience" aria-labelledby="experience-title" data-bed="tree">
	<div class="flat-inner">
		<h2 id="experience-title">Experience</h2>
		<div class="filters" role="group" aria-label="Show">
			<button type="button" data-filter="all" aria-pressed="true">All</button>
			<button type="button" data-filter="work" aria-pressed="false">Work</button>
			<button type="button" data-filter="leadership" aria-pressed="false">
				Leadership and volunteering
			</button>
		</div>

		<div class="timeline">
			{
				years.map(year => (
					<div class="year">
						<h3 class="year-label">{year}</h3>
						<ul class="roles" role="list">
							{entries
								.filter(entry => Math.floor(entry.start) === year)
								.map(role => (
									<li data-kind={role.kind}>
										<details class="role">
											<summary>
												<span class="role-head">
													<span class="role-title">{role.title}</span>
													<span class="role-org">{role.org}</span>
												</span>
												<span class="role-dates">{role.dates}</span>
												<svg class="role-caret" viewBox="0 0 24 24" aria-hidden="true">
													<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
												</svg>
											</summary>
											<ul class="points">
												{role.points.map(point => (
													<li>{point}</li>
												))}
											</ul>
										</details>
									</li>
								))}
						</ul>
					</div>
				))
			}
		</div>

	</div>
</section>

<script>
	import { click, milestone, scribe } from "../../scripts/sound";

	const section = document.getElementById("experience")!;
	const filters = [...section.querySelectorAll<HTMLButtonElement>(".filters button")];
	for (const button of filters) {
		button.addEventListener("click", () => {
			const kind = button.dataset.filter;
			for (const other of filters) other.setAttribute("aria-pressed", String(other === button));
			for (const item of section.querySelectorAll<HTMLElement>(".timeline li[data-kind]")) {
				item.hidden = kind !== "all" && item.dataset.kind !== kind;
			}
			for (const year of section.querySelectorAll<HTMLElement>(".timeline .year")) {
				year.hidden = !year.querySelector("li[data-kind]:not([hidden])");
			}
			click(true);
		});
	}

	// The rail fills to a line 60% of the way down the screen, and each year's
	// dot fills once the rail reaches it.
	const timeline = section.querySelector<HTMLElement>(".timeline")!;
	const years = [...timeline.querySelectorAll<HTMLElement>(".year")];
	let fillFrame = 0;
	let lastDepth = 0;
	let settled = false;
	function fill() {
		fillFrame = 0;
		const box = timeline.getBoundingClientRect();
		const depth = Math.min(Math.max(window.innerHeight * 0.6 - box.top, 0), box.height);
		timeline.style.setProperty("--fill", `${depth}px`);
		const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
		const dotOffset = parseFloat(getComputedStyle(timeline).getPropertyValue("--dot-top")) * rem;
		// The line scratches as it draws, and each year rings as the rail
		// reaches its dot; not on the first layout, and not for hidden years.
		if (settled && depth !== lastDepth) scribe(Math.abs(depth - lastDepth));
		lastDepth = depth;
		years.forEach((year, index) => {
			const reached = !year.hidden && year.offsetTop + dotOffset <= depth;
			const was = year.classList.contains("reached");
			year.classList.toggle("reached", reached);
			if (settled && !year.hidden && reached !== was) milestone(index, reached);
		});
		settled = true;
	}
	const queueFill = () => {
		if (!fillFrame) fillFrame = requestAnimationFrame(fill);
	};
	window.addEventListener("scroll", queueFill, { passive: true });
	window.addEventListener("resize", queueFill);
	for (const button of filters) button.addEventListener("click", queueFill);
	fill();

	// Hovering a summary is covered by the shared interaction sounds.
	for (const details of document.querySelectorAll<HTMLDetailsElement>("details.role")) {
		details.addEventListener("toggle", () => click(details.open));
	}
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}

	.filters button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35em 0.9em;
		border: 1px solid var(--color-rule);
		border-radius: 999px;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
	}

	.filters button[aria-pressed="true"] {
		background: var(--color-text);
		border-color: var(--color-text);
		color: var(--bg-experience);
	}

	/* A vertical rail with the year each group of roles started. The rail
	   fills downward as you scroll, and each year's dot fills as it's reached. */
	.timeline {
		--rail: 3.1rem;
		--dot-top: 1.2rem;
		--fill: 0px;
		position: relative;
		padding-left: 4.5rem;
	}

	.timeline::before,
	.timeline::after {
		content: "";
		position: absolute;
		top: 0;
		left: var(--rail);
		width: 2px;
		translate: -50% 0;
		border-radius: 1px;
	}

	.timeline::before {
		bottom: 0;
		background: color-mix(in srgb, var(--color-accent) 22%, transparent);
	}

	.timeline::after {
		height: var(--fill);
		background: linear-gradient(to bottom, var(--color-accent), #e0569b);
	}

	.year {
		position: relative;
		margin-bottom: var(--space-5);
	}

	.year[hidden] {
		display: none;
	}

	/* The dot sits exactly on the rail. */
	.year::before {
		content: "";
		position: absolute;
		z-index: 1;
		left: calc(var(--rail) - 4.5rem);
		top: var(--dot-top);
		width: 12px;
		height: 12px;
		translate: -50% -50%;
		border-radius: 50%;
		border: 2px solid var(--color-accent);
		background: var(--bg-experience);
		box-sizing: border-box;
		transition:
			background-color 300ms ease,
			box-shadow 300ms ease;
	}

	.year.reached::before {
		background: var(--color-accent);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 22%, transparent);
	}

	.year .year-label {
		position: absolute;
		left: -4.5rem;
		top: 0.7rem;
		margin: 0;
		width: 2.6rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: var(--color-text);
		text-align: right;
	}

	.roles {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.roles > li[hidden] {
		display: none;
	}

	summary {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-3) var(--space-2);
		cursor: pointer;
		list-style: none;
		border-radius: 6px;
		transition: background-color var(--dur-2);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		background: var(--color-surface);
	}

	.role-head {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}

	.role-title {
		font-weight: 600;
	}

	.role-org {
		color: var(--color-muted);
	}

	.role-dates {
		font-size: 0.85rem;
		color: var(--color-muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.role-caret {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--color-muted);
		transition: transform var(--dur-2);
	}

	details[open] .role-caret {
		transform: rotate(180deg);
	}

	.points {
		margin: 0;
		padding: var(--space-1) var(--space-2) var(--space-3) calc(var(--space-2) + 1.2rem);
		max-width: 68ch;
	}

	.points li {
		margin-bottom: var(--space-2);
		line-height: 1.55;
	}

	@media (max-width: 640px) {
		/* A slim rail at the left edge, with the year above its roles. */
		.timeline {
			--rail: 0.4rem;
			--dot-top: 0.7rem;
			padding-left: 1.5rem;
		}

		.year::before {
			left: calc(var(--rail) - 1.5rem);
		}

		.year .year-label {
			position: static;
			width: auto;
			margin: 0 0 var(--space-1);
			padding-left: var(--space-2);
			text-align: left;
		}

		summary {
			grid-template-columns: 1fr auto;
			gap: var(--space-2) var(--space-3);
		}

		.role-dates {
			grid-column: 1;
			grid-row: 2;
		}

		.role-caret {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}
</style>
