---
import { leadership, work, type Role } from "../../data/experience";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// "May 2025 to Aug 2025" -> 2025.33, the fractional year a role started.
function started(dates: string): number {
	const [month, year] = dates.split(/\s+to\s+/)[0].trim().split(/\s+/);
	return Number(year) + Math.max(0, MONTHS.indexOf(month)) / 12;
}

type Entry = Role & { kind: "work" | "leadership"; start: number };
const entries: Entry[] = [
	...work.map(role => ({ ...role, kind: "work" as const })),
	...leadership.map(role => ({ ...role, kind: "leadership" as const })),
]
	.map(role => ({ ...role, start: started(role.dates) }))
	.sort((a, b) => b.start - a.start);

const years = [...new Set(entries.map(entry => Math.floor(entry.start)))];

// The two most recent years show by default; earlier ones wait behind a button.
const RECENT = 2;
const earlier = entries.filter(entry => Math.floor(entry.start) < (years[RECENT - 1] ?? 0)).length;
---

<section class="flat experience" id="experience" aria-labelledby="experience-title" data-bed="tree">
	<div class="flat-inner">
		<h2 id="experience-title">Experience</h2>
		<div class="filters" role="group" aria-label="Show">
			<button type="button" data-filter="all" aria-pressed="true">All</button>
			<button type="button" data-filter="work" aria-pressed="false">Work</button>
			<button type="button" data-filter="leadership" aria-pressed="false">
				Leadership and volunteering
			</button>
		</div>

		<div class="timeline" id="experience-timeline">
			{
				years.map((year, index) => (
					<div class:list={["year", { earlier: index >= RECENT }]}>
						<h3 class="year-label">{year}</h3>
						<ul class="roles" role="list">
							{entries
								.filter(entry => Math.floor(entry.start) === year)
								.map(role => (
									<li data-kind={role.kind}>
										<details class="role">
											<summary>
												<span class="role-head">
													<span class="role-title">{role.title}</span>
													<span class="role-org">{role.org}</span>
												</span>
												<span class="role-dates">{role.dates}</span>
												<svg class="role-caret" viewBox="0 0 24 24" aria-hidden="true">
													<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
												</svg>
											</summary>
											<ul class="points">
												{role.points.map(point => (
													<li>{point}</li>
												))}
											</ul>
										</details>
									</li>
								))}
						</ul>
					</div>
				))
			}
		</div>

		{
			earlier > 0 && (
				<button
					type="button"
					class="more"
					aria-expanded="false"
					aria-controls="experience-timeline"
					data-more={`Show ${earlier} earlier roles, ${years.at(-1)} to ${years[RECENT]}`}
				>
					Show {earlier} earlier roles, {years.at(-1)} to {years[RECENT]}
				</button>
			)
		}
	</div>
</section>

<script>
	import { click, milestone, scribe } from "../../scripts/sound";

	const section = document.getElementById("experience")!;
	const filters = [...section.querySelectorAll<HTMLButtonElement>(".filters button")];
	for (const button of filters) {
		button.addEventListener("click", () => {
			const kind = button.dataset.filter;
			for (const other of filters) other.setAttribute("aria-pressed", String(other === button));
			for (const item of section.querySelectorAll<HTMLElement>(".timeline li[data-kind]")) {
				item.hidden = kind !== "all" && item.dataset.kind !== kind;
			}
			for (const year of section.querySelectorAll<HTMLElement>(".timeline .year")) {
				year.hidden = !year.querySelector("li[data-kind]:not([hidden])");
			}
			click(true);
		});
	}

	// Earlier years open and close under the button.
	const more = section.querySelector<HTMLButtonElement>(".more");
	more?.addEventListener("click", () => {
		const open = more.getAttribute("aria-expanded") !== "true";
		more.setAttribute("aria-expanded", String(open));
		more.textContent = open ? "Show fewer roles" : more.dataset.more!;
		timeline.classList.toggle("expanded", open);
		if (!open) more.scrollIntoView({ block: "nearest" });
		click(open);
		queueFill();
	});

	// The rail fills to a line 60% of the way down the screen. Each year's bulb
	// fills from the top as the liquid passes through it (--level), and the
	// year counts as reached once the liquid is at the bulb's centre.
	const timeline = section.querySelector<HTMLElement>(".timeline")!;
	const years = [...timeline.querySelectorAll<HTMLElement>(".year")];
	let fillFrame = 0;
	let lastDepth = 0;
	let settled = false;
	function fill() {
		fillFrame = 0;
		const box = timeline.getBoundingClientRect();
		const depth = Math.min(Math.max(window.innerHeight * 0.6 - box.top, 0), box.height);
		timeline.style.setProperty("--fill", `${depth}px`);
		const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
		const dotOffset = parseFloat(getComputedStyle(timeline).getPropertyValue("--dot-top")) * rem;
		// The line scratches as it draws, and each year rings as the rail
		// reaches its dot; not on the first layout, and not for hidden years.
		if (settled && depth !== lastDepth) scribe(Math.abs(depth - lastDepth));
		lastDepth = depth;
		const radius = parseFloat(getComputedStyle(timeline).getPropertyValue("--bulb")) / 2;
		years.forEach((year, index) => {
			const shown = year.offsetParent !== null;
			const centre = year.offsetTop + dotOffset;
			const level = Math.min(Math.max((depth - (centre - radius)) / (2 * radius), 0), 1);
			year.style.setProperty("--level", String(shown ? level : 0));
			const reached = shown && centre <= depth;
			const was = year.classList.contains("reached");
			year.classList.toggle("reached", reached);
			if (settled && shown && reached !== was) milestone(index, reached);
		});
		settled = true;
	}
	const queueFill = () => {
		if (!fillFrame) fillFrame = requestAnimationFrame(fill);
	};
	window.addEventListener("scroll", queueFill, { passive: true });
	window.addEventListener("resize", queueFill);
	for (const button of filters) button.addEventListener("click", queueFill);
	fill();

	// Hovering a summary is covered by the shared interaction sounds.
	for (const details of document.querySelectorAll<HTMLDetailsElement>("details.role")) {
		details.addEventListener("toggle", () => click(details.open));
	}
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}

	.filters button {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35em 0.9em;
		border: 1px solid var(--color-rule);
		border-radius: 999px;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
	}

	.filters button[aria-pressed="true"] {
		background: var(--color-text);
		border-color: var(--color-text);
		color: var(--bg-experience);
	}

	/* A glass tube down the left with the year each group of roles started.
	   Liquid runs down it as you scroll, and at each year the tube widens into
	   a bulb that fills from the top as the liquid passes through. Layers, back
	   to front: the tube, the liquid in it, each bulb's glass (which hides the
	   tube's liquid inside it), then the bulb's own liquid. */
	.timeline {
		--rail: 3.1rem;
		--gutter: 4.5rem;
		--dot-top: 1.2rem;
		--fill: 0px;
		--tube: 6px;
		--bulb: 18px;
		--liquid: var(--color-accent);
		--liquid-deep: color-mix(in oklch, var(--color-accent) 82%, #2b0fd6);
		--glass: color-mix(in srgb, var(--color-accent) 10%, var(--bg-experience));
		--glass-edge: color-mix(in srgb, var(--color-accent) 38%, transparent);
		--glint: inset 1.5px 0 0 rgba(255, 255, 255, 0.22);
		position: relative;
		isolation: isolate;
		padding-left: var(--gutter);
	}

	.timeline::before,
	.timeline::after {
		content: "";
		position: absolute;
		top: 0;
		left: var(--rail);
		translate: -50% 0;
	}

	.timeline::before {
		z-index: 0;
		bottom: 0;
		width: var(--tube);
		border: 1px solid var(--glass-edge);
		border-radius: var(--tube);
		background: var(--glass);
		box-shadow: var(--glint);
		box-sizing: border-box;
	}

	.timeline::after {
		z-index: 1;
		height: var(--fill);
		width: calc(var(--tube) - 2px);
		border-radius: 0 0 var(--tube) var(--tube);
		background: var(--liquid);
	}

	.year {
		--level: 0;
		position: relative;
		margin-bottom: var(--space-5);
	}

	.year[hidden],
	.timeline:not(.expanded) .year.earlier {
		display: none;
	}

	.year::before,
	.year::after {
		content: "";
		position: absolute;
		left: calc(var(--rail) - var(--gutter));
		top: var(--dot-top);
		translate: -50% -50%;
		border-radius: 50%;
		box-sizing: border-box;
	}

	/* The bulb's glass, drawn over the tube so the two read as one vessel. */
	.year::before {
		z-index: 2;
		width: var(--bulb);
		height: var(--bulb);
		border: 1px solid var(--glass-edge);
		background: var(--glass);
		box-shadow: var(--glint);
	}

	/* The liquid inside the bulb, filled to --level from the top, and a
	   little deeper in colour where the vessel is wider. */
	.year::after {
		z-index: 3;
		width: calc(var(--bulb) - 3px);
		height: calc(var(--bulb) - 3px);
		background: linear-gradient(
			to bottom,
			var(--liquid-deep) calc(var(--level) * 100%),
			transparent calc(var(--level) * 100%)
		);
		transition: box-shadow 400ms ease;
	}

	.year.reached::after {
		box-shadow: 0 0 10px color-mix(in srgb, var(--liquid) 45%, transparent);
	}

	/* Earlier years, under the timeline. */
	.more {
		display: block;
		margin: 0 0 0 var(--gutter);
		padding: 0.45em 1.1em;
		font: inherit;
		font-size: 0.9rem;
		color: var(--color-text);
		border: 1px solid var(--color-rule);
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
		transition:
			border-color var(--dur-2),
			background-color var(--dur-2);
	}

	.more:hover,
	.more:focus-visible {
		border-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
	}

	.year .year-label {
		position: absolute;
		left: calc(-1 * var(--gutter));
		top: 0.7rem;
		margin: 0;
		width: 2.6rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: var(--color-text);
		text-align: right;
	}

	.roles {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.roles > li[hidden] {
		display: none;
	}

	summary {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-3) var(--space-2);
		cursor: pointer;
		list-style: none;
		border-radius: 6px;
		transition: background-color var(--dur-2);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		background: var(--color-surface);
	}

	.role-head {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}

	.role-title {
		font-weight: 600;
	}

	.role-org {
		color: var(--color-muted);
	}

	.role-dates {
		font-size: 0.85rem;
		color: var(--color-muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.role-caret {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--color-muted);
		transition: transform var(--dur-2);
	}

	details[open] .role-caret {
		transform: rotate(180deg);
	}

	.points {
		margin: 0;
		padding: var(--space-1) var(--space-2) var(--space-3) calc(var(--space-2) + 1.2rem);
		max-width: 68ch;
	}

	.points li {
		margin-bottom: var(--space-2);
		line-height: 1.55;
	}

	@media (max-width: 640px) {
		/* A slim rail at the left edge, with the year above its roles. */
		.timeline {
			--rail: 0.5rem;
			--gutter: 1.6rem;
			--dot-top: 0.7rem;
		}

		.year .year-label {
			position: static;
			width: auto;
			margin: 0 0 var(--space-1);
			padding-left: var(--space-2);
			text-align: left;
		}

		summary {
			grid-template-columns: 1fr auto;
			gap: var(--space-2) var(--space-3);
		}

		.role-dates {
			grid-column: 1;
			grid-row: 2;
		}

		.role-caret {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}
</style>
