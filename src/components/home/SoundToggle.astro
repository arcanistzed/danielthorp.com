<button
	class="sound-toggle"
	type="button"
	aria-pressed="false"
	aria-label="Sound and vibration"
	title="Sound and vibration"
>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path>
		<g class="on" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
			<path d="M15.5 9a4.2 4.2 0 0 1 0 6"></path>
			<path d="M18 6.5a7.8 7.8 0 0 1 0 11"></path>
		</g>
		<g class="off" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
			<path d="M16 9.5l5 5M21 9.5l-5 5"></path>
		</g>
	</svg>
</button>

<script>
	import { isEnabled, setEnabled, chord, vibrate } from "../../scripts/sound";

	const button = document.querySelector<HTMLButtonElement>(".sound-toggle")!;
	const render = () => {
		const on = isEnabled();
		const label = on ? "Mute sound" : "Enable sound";
		button.setAttribute("aria-pressed", String(on));
		button.setAttribute("aria-label", label);
		button.title = label;
	};

	button.addEventListener("click", () => {
		const on = !isEnabled();
		setEnabled(on);
		if (!on) return;
		chord([60, 67, 72, 76], 1.8);
		// Sound is on: one tap under the finger with the chord.
		vibrate(12);
	});
	window.addEventListener("sound-change", render);

	render();
</script>

<style>
	.sound-toggle {
		position: fixed;
		top: var(--space-4);
		right: var(--space-4);
		z-index: 20;
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		padding: 0;
		color: #e6e3ee;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 50%;
		background: rgba(16, 16, 21, 0.9);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		cursor: pointer;
		transition: opacity 700ms ease;
	}

	.sound-toggle:hover {
		color: #fff;
	}

	.sound-toggle svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	.sound-toggle[aria-pressed="false"] .on,
	.sound-toggle[aria-pressed="true"] .off {
		display: none;
	}

	:global(html.intro:not(.intro-done)) .sound-toggle {
		opacity: 0;
		pointer-events: none;
	}

	/* Phones: the menu button takes the corner, so sound sits just left of it. */
	@media (max-width: 760px) {
		.sound-toggle {
			right: calc(var(--space-4) + 2.6rem + var(--space-2));
		}
	}
</style>
