---
import { categories, projects } from "../../data/projects";
---

<section class="flat projects" id="projects" aria-labelledby="projects-title" data-bed="matrix" data-sfx="terminal">
	<div class="flat-inner">
		<h2 id="projects-title">
			<span class="prompt" aria-hidden="true">~/</span>projects<span class="prompt" aria-hidden="true"> $</span><span class="cursor" aria-hidden="true"></span>
		</h2>
		<p class="lede">
			Personal and volunteer projects. Professional work is under Experience.
		</p>

		<div class="filters" role="group" aria-label="Show">
			<button type="button" data-filter="all" aria-pressed="true">All</button>
			{
				categories.map(([id, label]) => (
					<button type="button" data-filter={id} aria-pressed="false">
						{label}
					</button>
				))
			}
		</div>

		<ul class="cards" role="list">
			{
				projects.map(project => (
					<li class="card" data-category={project.category}>
						<details>
							<summary>
								<span class="card-head">
									<span class="card-title">{project.name}</span>
									<span class="card-meta">
										{project.tags.join(" · ")}
									</span>
								</span>
								<svg class="caret" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>
							<p class="card-summary">{project.summary}</p>
							<p class="card-links">
								<a href={`https://github.com/${project.repo}`} target="_blank" rel="noopener noreferrer">
									<span class="prompt" aria-hidden="true">$ </span>source
									<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
									<span class="sr-only">{project.name} on GitHub (opens in new tab)</span>
								</a>
								{project.url && (
									<a href={project.url} target="_blank" rel="noopener noreferrer">
										<span class="prompt" aria-hidden="true">$ </span>live site
										<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										<span class="sr-only">{project.name} (opens in new tab)</span>
									</a>
								)}
							</p>
						</details>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import { beep } from "../../scripts/sound";

	const section = document.getElementById("projects")!;
	const filters = [...section.querySelectorAll<HTMLButtonElement>(".filters button")];
	for (const button of filters) {
		button.addEventListener("click", () => {
			const kind = button.dataset.filter;
			for (const other of filters) other.setAttribute("aria-pressed", String(other === button));
			for (const card of section.querySelectorAll<HTMLElement>(".card")) {
				card.hidden = kind !== "all" && card.dataset.category !== kind;
			}
			beep(true);
		});
	}

	// Hovering a summary is covered by the shared interaction sounds.
	for (const details of section.querySelectorAll<HTMLDetailsElement>(".card details")) {
		details.addEventListener("toggle", () => beep(details.open));
	}
</script>

<style>
	/* A terminal: monospace throughout, a shell prompt for the heading, and
	   phosphor green for the prompt, the cursor and the selected filter. */
	.projects {
		--term: #7ee787;
		--term-dim: color-mix(in srgb, var(--term) 45%, transparent);
		font-family: var(--font-mono);
	}

	:global(:root[data-theme="light"]) .projects {
		/* Dark enough for the selected filter's pale text to keep AA contrast. */
		--term: #1a7634;
	}

	.projects h2 {
		font-family: var(--font-mono);
		font-weight: 500;
		letter-spacing: 0;
		padding-bottom: var(--space-3);
		border-bottom: 1px dashed var(--term-dim);
	}

	.prompt {
		color: var(--term);
	}

	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1em;
		margin-left: 0.15em;
		vertical-align: -0.12em;
		background: var(--term);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}

	.projects .lede {
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}

	.filters button {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.35em 0.9em;
		border: 1px solid var(--term-dim);
		border-radius: 2px;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
	}

	.filters button:hover {
		color: var(--color-text);
	}

	.filters button[aria-pressed="true"] {
		background: var(--term);
		border-color: var(--term);
		color: var(--bg-projects);
	}

	.cards {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Each project is a card: a light outline and tint on hover. */
	.card {
		position: relative;
		border: 1px solid transparent;
		border-left: 2px solid transparent;
		border-radius: 0;
		transition:
			border-color var(--dur-2),
			background-color var(--dur-2);
	}

	.card[hidden] {
		display: none;
	}

	/* Hovering a row selects it, like a highlighted line in a terminal list. */
	.card:hover,
	.card:focus-within {
		border-color: color-mix(in srgb, var(--term) 22%, transparent);
		border-left-color: var(--term);
		background: color-mix(in srgb, var(--term) 6%, transparent);
	}

	summary {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4);
		cursor: pointer;
		list-style: none;
		border-radius: 0;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.card-head {
		display: grid;
		gap: 0.2rem;
	}

	.card-title {
		font-weight: 600;
		font-size: 1.05rem;
	}

	/* Commands at the bottom of the card open the source and the live site. */
	.card-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		margin: 0;
		padding: 0 var(--space-4) var(--space-4);
	}

	.card-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.3em 0.7em;
		border: 1px solid var(--term-dim);
		border-radius: 2px;
		font-size: 0.85rem;
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color var(--dur-2),
			background-color var(--dur-2);
	}

	.card-links a:hover,
	.card-links a:focus-visible {
		border-color: var(--term);
		background: color-mix(in srgb, var(--term) 10%, transparent);
	}

	.arrow {
		width: 0.85em;
		height: 0.85em;
		color: var(--color-muted);
		transition:
			color var(--dur-2),
			transform var(--dur-2);
	}

	.card-links a:hover .arrow,
	.card-links a:focus-visible .arrow {
		color: var(--color-text);
		transform: translate(1px, -1px);
	}

	.card-meta {
		font-size: 0.85rem;
		color: var(--color-muted);
	}

	.caret {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--color-muted);
		transition: transform var(--dur-2);
	}

	details[open] .caret {
		transform: rotate(180deg);
	}

	.card-summary {
		margin: 0;
		padding: 0 var(--space-4) var(--space-4);
		max-width: 68ch;
		line-height: 1.6;
	}
</style>
