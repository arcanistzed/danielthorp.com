---
import { projectGroups } from "../../data/projects";
---

<section class="flat projects" id="projects" aria-labelledby="projects-title">
	<div class="flat-inner">
		<h2 id="projects-title">Projects</h2>
		<p class="lede">
			Some of what I’ve built. It isn’t a complete list, and it leaves
			out what I built during internships.
		</p>
		{
			projectGroups.map(group => (
				<>
					<h3>{group.group}</h3>
					<ul class="project-list" role="list">
						{group.projects.map(project => (
							<li class="project">
								<h4>
									<a
										href={`https://github.com/${project.repo}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										{project.name}
										<span class="sr-only"> (opens in new tab)</span>
									</a>
								</h4>
								<p>{project.summary}</p>
								<ul class="tags" role="list" aria-label="Built with">
									{project.tags.map(tag => (
										<li class="tag">{tag}</li>
									))}
								</ul>
							</li>
						))}
					</ul>
				</>
			))
		}
	</div>
</section>

<style>
	.project-list {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project {
		padding: var(--space-4) 0;
	}

	.project h4 {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0 0 var(--space-2);
		font-size: 1.08rem;
	}

	.project h4 a {
		color: var(--color-text);
		text-decoration-color: var(--color-rule);
	}

	.project h4 a:hover {
		text-decoration-color: currentColor;
	}

	.project p {
		margin: 0 0 var(--space-3);
		max-width: 68ch;
		line-height: 1.6;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
