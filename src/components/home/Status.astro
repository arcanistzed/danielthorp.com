---
import { execSync } from "node:child_process";
import { ROLE_WIDTH as ROLE, STATUS_WIDTH as STATUS, statuses, updatedFallback } from "../../data/now";

// The date the status file last changed, so the board can't silently go stale.
let updated = updatedFallback;
try {
	const git = (command: string) =>
		execSync(command, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
	// A shallow clone (as some build services make) only has the latest
	// commit, whose date says nothing about this file; keep the fallback then.
	const shallow = git("git rev-parse --is-shallow-repository") === "true";
	const iso = shallow ? "" : git("git log -1 --format=%cs -- src/data/now.ts");
	if (iso) {
		updated = new Date(`${iso}T12:00:00`).toLocaleDateString("en-CA", {
			year: "numeric",
			month: "long",
			day: "numeric",
		});
	}
} catch {}

// The flaps would silently cut off longer text, so stop the build instead.
const tooLong = statuses.flatMap(({ role, status }) => [
	...([...role].length > ROLE ? [`role "${role}" is over ${ROLE} characters`] : []),
	...([...status].length > STATUS ? [`status "${status}" is over ${STATUS} characters`] : []),
]);
if (tooLong.length) {
	throw new Error(`src/data/now.ts: ${tooLong.join("; ")}.`);
}

// Flap letters live in data-ch and the script writes them in, so tools that read
// the HTML as text get the readable copy beside each row instead of one letter
// per element.
const flaps = (text: string, width: number) =>
	[...text.padEnd(width, " ")].slice(0, width);
---

<section class="flat status" id="status" aria-labelledby="status-title" data-bed="status">
	<div class="flat-inner">
		<h2 id="status-title">Current status</h2>

		<div class="board" data-sfx="flap">
			<div class="board-bar" aria-hidden="true">
				<span class="flaps bar-city">
					{flaps("Ottawa", 6).map(ch => <span class="flap" data-ch={ch} />)}
				</span>
				<span class="flaps bar-clock">
					{flaps("", 5).map(ch => <span class="flap">{ch}</span>)}
				</span>
			</div>
			<div class="board-head" aria-hidden="true">
				<span>Role</span>
				<span>Where</span>
				<span>Status</span>
			</div>
			<ul class="rows" role="list">
				{
					statuses.map(item => (
						<li class="row" data-sfx-hover>
							<p class="sr-only">
								{item.role}: {item.status}.
							</p>
							<span class="flaps role-flaps" aria-hidden="true" data-text={item.role}>
								{flaps(item.role, ROLE).map(ch => (
									<span class="flap" data-ch={ch} />
								))}
							</span>
							<span class="where">
								{item.href ? (
									<a href={item.href} target="_blank" rel="noopener noreferrer">
										{item.where}
										<span class="sr-only"> (opens in new tab)</span>
									</a>
								) : (
									<span>{item.where}</span>
								)}
							</span>
							<span class="flaps state" aria-hidden="true" data-text={item.status}>
								{flaps(item.status, STATUS).map(ch => (
									<span class="flap" data-ch={ch} />
								))}
							</span>
							<span class="detail">{item.detail}</span>
						</li>
					))
				}
			</ul>
		</div>
		<p class="updated">Updated {updated}</p>
	</div>
</section>

<script>
	import { clack, vibrate } from "../../scripts/sound";

	const board = document.querySelector<HTMLElement>(".board")!;
	for (const flap of board.querySelectorAll<HTMLElement>(".flap[data-ch]")) {
		flap.textContent = flap.dataset.ch ?? " ";
	}
	// Ottawa time on flaps, 24-hour like a station board. A flap that changes
	// flips over.
	const clockFlaps = [...board.querySelectorAll<HTMLElement>(".bar-clock .flap")];
	const tickClock = () => {
		const time = new Date().toLocaleTimeString("en-GB", {
			hour: "2-digit",
			minute: "2-digit",
			hourCycle: "h23",
			timeZone: "America/Toronto",
		});
		[...time.padEnd(5)].forEach((ch, i) => {
			const flap = clockFlaps[i];
			if (!flap || flap.textContent === ch) return;
			flap.textContent = ch;
			flap.classList.remove("flip");
			void flap.offsetWidth;
			flap.classList.add("flip");
		});
	};
	tickClock();
	setInterval(tickClock, 15000);

	const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 -";
	const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

	// Each flap cycles through letters before landing, row by row.
	function run() {
		const rows = [...board.querySelectorAll<HTMLElement>(".row")];
		let lastClack = 0;
		let boardSettles = 0;
		rows.forEach((row, r) => {
			const flaps = [...row.querySelectorAll<HTMLElement>(".flap")];
			let settles = 0;
			flaps.forEach((flap, i) => {
				const target = flap.textContent ?? " ";
				const steps = 6 + Math.floor(Math.random() * 8) + (i % 4);
				let step = 0;
				flap.textContent = " ";
				const start = r * 260 + i * 25;
				settles = Math.max(settles, start + steps * 55);
				setTimeout(function next() {
					step += 1;
					const done = step >= steps;
					flap.textContent = done
						? target
						: CHARS[Math.floor(Math.random() * CHARS.length)];
					flap.classList.remove("flip");
					void flap.offsetWidth;
					flap.classList.add("flip");
					const now = performance.now();
					if (now - lastClack > 28) {
						clack();
						lastClack = now;
					}
					if (!done) setTimeout(next, 55);
				}, start);
			});
			boardSettles = Math.max(boardSettles, settles);
		});
		// One light tick as the last flap on the board settles.
		setTimeout(() => vibrate(10), boardSettles);
	}

	if (!still) {
		let started = false;
		new IntersectionObserver(
			([entry], observer) => {
				if (entry.isIntersecting && !started) {
					started = true;
					observer.disconnect();
					run();
				}
			},
			{ threshold: 0.4 },
		).observe(board);
	}
</script>

<style>
	.status .flat-inner {
		max-width: 60rem;
	}

	.board {
		--board: #0c0d10;
		--flap: #1b1c21;
		--flap-text: #f4f1e6;
		--amber: #ffb547;
		--bar: #15161b;
		--edge: rgba(255, 255, 255, 0.06);
		--head-text: #8d8b96;
		--detail-text: #a6a4ae;
		--flap-gap: #0a0a0d;
		--flap-low: #202128;
		--underline: rgba(255, 255, 255, 0.3);

		border-radius: 10px;
		background: var(--board);
		box-shadow:
			inset 0 0 0 1px var(--edge),
			0 20px 50px rgba(0, 0, 0, 0.35);
		color: var(--flap-text);
		overflow: hidden;
	}

	.board-bar {
		display: flex;
		justify-content: space-between;
		padding: var(--space-3) var(--space-5);
		background: var(--bar);
		border-bottom: 1px solid var(--edge);
		font-weight: 600;
		color: var(--amber);
	}

	.board-bar {
		align-items: center;
	}

	/* Without the script, show the letters the script would have written. */
	:global(html:not(.js)) .flap[data-ch]::before {
		content: attr(data-ch);
	}

	.bar-city .flap {
		color: var(--amber);
	}

	.board-head,
	.row {
		display: grid;
		grid-template-columns:
			calc(18 * 0.9775rem + 17 * 2px)
			minmax(0, 1fr)
			calc(11 * 0.9775rem + 10 * 2px);
		column-gap: var(--space-5);
		align-items: center;
		padding: 0 var(--space-5);
	}

	.board-head {
		padding-top: var(--space-3);
		padding-bottom: var(--space-2);
		font-size: 0.8rem;
		color: var(--head-text);
	}

	.rows {
		margin: 0;
		padding: 0 0 var(--space-3);
		list-style: none;
	}

	.row {
		row-gap: var(--space-1);
		padding-top: var(--space-3);
		padding-bottom: var(--space-3);
	}

	.flaps {
		display: inline-flex;
		gap: 2px;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.flap {
		position: relative;
		display: inline-grid;
		place-items: center;
		width: 1.15em;
		height: 1.6em;
		border-radius: 3px;
		background: linear-gradient(
			to bottom,
			var(--flap) 0 49%,
			var(--flap-gap) 49% 51%,
			var(--flap-low) 51% 100%
		);
		color: var(--flap-text);
		white-space: pre;
	}

	.flap.flip {
		animation: flip 110ms ease-out;
	}

	@keyframes flip {
		from {
			transform: scaleY(0.2);
		}
	}

	.state .flap {
		color: var(--amber);
	}

	.where {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.where a {
		color: var(--flap-text);
		text-decoration-color: var(--underline);
	}

	.where a:hover {
		text-decoration-color: currentColor;
	}

	.detail {
		grid-column: 1 / -1;
		font-size: 0.88rem;
		color: var(--detail-text);
	}

	.updated {
		margin: var(--space-4) 0 0;
		font-size: 0.85rem;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.board-head {
			display: none;
		}

		.row {
			grid-template-columns: 1fr;
			padding-inline: var(--space-4);
		}

		.where {
			white-space: normal;
		}

		/* 18 flaps fit a 375px phone at 0.85rem; only narrower screens shrink them. */
		.flaps {
			font-size: clamp(0.7rem, 3.6vw, 0.85rem);
		}
	}

	/* Light mode: a white-flap board with dark lettering. */
	:global(:root[data-theme="light"]) .board {
		--board: #e4e5e9;
		--flap: #fbfbfc;
		--flap-text: #1c1c22;
		--amber: #a35a00;
		--bar: #d6d8de;
		--edge: rgba(0, 0, 0, 0.08);
		--head-text: #5d5d68;
		--detail-text: #4a4a55;
		--flap-gap: #b9bbc2;
		--flap-low: #eef0f3;
		--underline: rgba(0, 0, 0, 0.3);
		box-shadow:
			inset 0 0 0 1px var(--edge),
			0 16px 40px rgba(20, 20, 40, 0.12);
	}

</style>
