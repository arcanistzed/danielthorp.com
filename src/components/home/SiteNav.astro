---
const links = [
	["about", "About me"],
	["status", "Current status"],
	["experience", "Experience"],
	["projects", "Projects"],
	["writing", "Writing"],
	["contact", "Contact"],
];
---

<nav class="site-nav" aria-label="Sections">
	<button
		class="nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-nav-list"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M4 7h16M4 12h16M4 17h16"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"></path>
		</svg>
		<span class="nav-current">Menu</span>
	</button>
	<ul id="site-nav-list" role="list">
		<li class="indicator" aria-hidden="true"></li>
		{
			links.map(([id, label]) => (
				<li>
					<a href={`#${id}`} data-section={id}>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	import { installSmoothScroll } from "../../scripts/smooth-scroll";
	import { click } from "../../scripts/sound";

	installSmoothScroll();

	const nav = document.querySelector<HTMLElement>(".site-nav")!;
	const toggle = nav.querySelector<HTMLButtonElement>(".nav-toggle")!;
	const links = [...nav.querySelectorAll<HTMLAnchorElement>("a[data-section]")];

	toggle.addEventListener("click", () => {
		const open = nav.classList.toggle("open");
		toggle.setAttribute("aria-expanded", String(open));
		click(open);
	});

	// Escape closes the phone menu and returns focus to its button.
	nav.addEventListener("keydown", event => {
		if (event.key !== "Escape" || !nav.classList.contains("open")) return;
		nav.classList.remove("open");
		toggle.setAttribute("aria-expanded", "false");
		click(false);
		toggle.focus();
	});
	for (const link of links) {
		link.addEventListener("click", () => {
			nav.classList.remove("open");
			toggle.setAttribute("aria-expanded", "false");
		});
	}

	// A pill slides to the link for the section in the middle of the viewport.
	const list = nav.querySelector<HTMLElement>("ul")!;
	const indicator = nav.querySelector<HTMLElement>(".indicator")!;
	let current: HTMLAnchorElement | null = null;

	function moveIndicator() {
		if (!current || current.offsetParent === null) {
			indicator.classList.remove("shown");
			return;
		}
		const box = list.getBoundingClientRect();
		const rect = current.getBoundingClientRect();
		indicator.style.width = `${rect.width}px`;
		indicator.style.height = `${rect.height}px`;
		indicator.style.transform = `translate(${rect.left - box.left - list.clientLeft}px, ${rect.top - box.top - list.clientTop}px)`;
		indicator.classList.add("shown");
	}

	const label = nav.querySelector<HTMLElement>(".nav-current")!;

	function setCurrent(id: string | null) {
		current = links.find(link => link.dataset.section === id) ?? null;
		label.textContent = current?.textContent?.trim() ?? "Menu";
		nav.classList.toggle("at-top", !current);
		for (const link of links) {
			const on = link === current;
			link.classList.toggle("current", on);
			if (on) link.setAttribute("aria-current", "true");
			else link.removeAttribute("aria-current");
		}
		moveIndicator();
	}

	// The section crossing the middle of the viewport is current, except at
	// the very bottom of the page: a short last section on a tall screen
	// never reaches the middle, so it takes over once there is no more to
	// scroll.
	const lastId = links[links.length - 1].dataset.section!;
	let observed: string | null = null;
	let shown: string | null | undefined;
	function update() {
		const root = document.documentElement;
		const atBottom = observed !== null && window.scrollY + window.innerHeight >= root.scrollHeight - 2;
		const id = atBottom ? lastId : observed;
		if (id !== shown) setCurrent((shown = id));
	}

	const observer = new IntersectionObserver(
		entries => {
			for (const entry of entries) {
				if (entry.isIntersecting) observed = entry.target.id === "top" ? null : entry.target.id;
			}
			update();
		},
		{ rootMargin: "-45% 0px -50% 0px" },
	);
	let frame = 0;
	window.addEventListener(
		"scroll",
		() => {
			if (!frame) frame = requestAnimationFrame(() => ((frame = 0), update()));
		},
		{ passive: true },
	);
	for (const id of ["top", ...links.map(link => link.dataset.section!)]) {
		const section = document.getElementById(id);
		if (section) observer.observe(section);
	}
	window.addEventListener("resize", moveIndicator);
	toggle.addEventListener("click", () => requestAnimationFrame(moveIndicator));
	document.fonts?.ready.then(moveIndicator);
</script>

<style>
	.site-nav {
		position: fixed;
		top: var(--space-4);
		left: var(--space-4);
		z-index: 20;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		transition: opacity 700ms ease;
	}

	ul {
		position: relative;
		display: flex;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-1);
		list-style: none;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(14, 14, 18, 0.62);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.indicator {
		position: absolute;
		top: 0;
		left: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.15);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
		opacity: 0;
		pointer-events: none;
		transition:
			transform 420ms cubic-bezier(0.65, 0, 0.25, 1),
			width 420ms cubic-bezier(0.65, 0, 0.25, 1),
			height 420ms cubic-bezier(0.65, 0, 0.25, 1),
			opacity 300ms ease;
	}

	.indicator.shown {
		opacity: 1;
	}

	a {
		position: relative;
		display: block;
		padding: 0.35em 0.85em;
		border-radius: 999px;
		color: #d6d3e0;
		text-decoration: none;
		white-space: nowrap;
	}

	a:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.08);
	}

	a.current {
		color: #fff;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		gap: var(--space-2);
		padding: 0.45em 0.9em;
		font: inherit;
		color: #e6e3ee;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: rgba(14, 14, 18, 0.62);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		cursor: pointer;
	}

	.nav-toggle svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	/* Hidden while the intro plays. */
	:global(html.intro:not(.intro-done)) .site-nav {
		opacity: 0;
		pointer-events: none;
	}

	/* Phones: one pill at the bottom centre naming the current section. */
	@media (max-width: 760px) {
		.site-nav {
			top: auto;
			left: 50%;
			bottom: var(--space-4);
			translate: -50% 0;
		}

		:global(html.js) .site-nav.at-top:not(.open):not(:focus-within) {
			opacity: 0;
			pointer-events: none;
		}

		:global(html.js) .nav-toggle {
			display: inline-flex;
		}

		:global(html.js) ul {
			display: none;
			position: absolute;
			bottom: calc(100% + var(--space-2));
			left: 50%;
			translate: -50% 0;
			flex-direction: column;
			min-width: 12rem;
		}

		:global(html.js) .site-nav.open ul {
			display: flex;
		}

		ul {
			flex-wrap: wrap;
			border-radius: var(--radius-1);
		}

		a,
		.indicator {
			border-radius: calc(var(--radius-1) - 2px);
		}
	}
</style>
