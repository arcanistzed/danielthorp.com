---
const links = [
	["about", "About me"],
	["status", "Current status"],
	["experience", "Experience"],
	["projects", "Projects"],
	["writing", "Opinion"],
	["contact", "Contact"],
];
---

<nav class="site-nav" aria-label="Sections">
	<button
		class="nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-nav-list"
		aria-label="Open menu"
	>
		<svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M4 7h16M4 12h16M4 17h16"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"></path>
		</svg>
		<svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M6 6l12 12M18 6L6 18"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"></path>
		</svg>
	</button>
	<ul id="site-nav-list" role="list">
		<li class="indicator" aria-hidden="true"></li>
		{
			links.map(([id, label]) => (
				<li>
					<a href={`#${id}`} data-section={id}>
						{label}
					</a>
				</li>
			))
		}
		<li class="menu-theme-row">
			<button class="menu-theme" type="button">Switch to light mode</button>
		</li>
	</ul>
</nav>

<script>
	import { installSmoothScroll } from "../../scripts/smooth-scroll";
	import { click } from "../../scripts/sound";

	installSmoothScroll();

	const nav = document.querySelector<HTMLElement>(".site-nav")!;
	let current: HTMLAnchorElement | null = null;
	const toggle = nav.querySelector<HTMLButtonElement>(".nav-toggle")!;
	const links = [...nav.querySelectorAll<HTMLAnchorElement>("a[data-section]")];

	// Phones: the toggle opens a full-screen menu. "menu-open" and "menu-close"
	// are dispatched on window for sound to follow.
	const list = nav.querySelector<HTMLElement>("ul")!;
	const themeButton = nav.querySelector<HTMLButtonElement>(".menu-theme")!;
	const isOpen = () => nav.classList.contains("open");

	function setOpen(open: boolean, { restoreFocus = true, keyboard = true } = {}) {
		if (open === isOpen()) return;
		nav.classList.toggle("open", open);
		document.documentElement.classList.toggle("menu-open", open);
		toggle.setAttribute("aria-expanded", String(open));
		toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		click(open);
		window.dispatchEvent(new Event(open ? "menu-open" : "menu-close"));
		// Move focus into the menu; show the ring only when opened by keyboard.
		if (open) (current ?? links[0]).focus({ focusVisible: keyboard } as FocusOptions);
		else if (restoreFocus) toggle.focus();
	}

	// A click with detail 0 came from the keyboard (Enter or Space).
	toggle.addEventListener("click", event => setOpen(!isOpen(), { keyboard: event.detail === 0 }));

	// A link closes the menu, then the page glides to its section.
	for (const link of links) {
		link.addEventListener("click", () => setOpen(false, { restoreFocus: false }));
	}

	// Tapping the backdrop closes it too.
	list.addEventListener("click", event => {
		if (event.target === list) setOpen(false);
	});

	// Escape closes; Tab stays inside the open menu.
	nav.addEventListener("keydown", event => {
		if (!isOpen()) return;
		if (event.key === "Escape") {
			setOpen(false);
			return;
		}
		if (event.key !== "Tab") return;
		const items: HTMLElement[] = [toggle, ...links, themeButton];
		const i = items.indexOf(document.activeElement as HTMLElement);
		const next = event.shiftKey
			? items[(i - 1 + items.length) % items.length]
			: items[(i + 1) % items.length];
		event.preventDefault();
		next.focus();
	});

	// The theme control lives in the menu on phones and drives the corner
	// toggle, so both stay in sync.
	const themeToggle = () => document.querySelector<HTMLButtonElement>(".theme-toggle");
	const syncTheme = () => {
		themeButton.textContent = themeToggle()?.getAttribute("aria-label") ?? "Switch theme";
	};
	themeButton.addEventListener("click", () => {
		themeToggle()?.click();
		syncTheme();
	});
	syncTheme();
	new MutationObserver(syncTheme).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ["data-theme"],
	});

	// A pill slides to the link for the section in the middle of the viewport.
	const indicator = nav.querySelector<HTMLElement>(".indicator")!;

	function moveIndicator() {
		if (!current || current.offsetParent === null) {
			indicator.classList.remove("shown");
			return;
		}
		const box = list.getBoundingClientRect();
		const rect = current.getBoundingClientRect();
		indicator.style.width = `${rect.width}px`;
		indicator.style.height = `${rect.height}px`;
		indicator.style.transform = `translate(${rect.left - box.left - list.clientLeft}px, ${rect.top - box.top - list.clientTop}px)`;
		indicator.classList.add("shown");
	}

	function setCurrent(id: string | null) {
		current = links.find(link => link.dataset.section === id) ?? null;
		for (const link of links) {
			const on = link === current;
			link.classList.toggle("current", on);
			if (on) link.setAttribute("aria-current", "true");
			else link.removeAttribute("aria-current");
		}
		moveIndicator();
	}

	// The section crossing the middle of the viewport is current, except at
	// the very bottom of the page: a short last section on a tall screen
	// never reaches the middle, so it takes over once there is no more to
	// scroll.
	const lastId = links[links.length - 1].dataset.section!;
	let observed: string | null = null;
	let shown: string | null | undefined;
	function update() {
		const root = document.documentElement;
		const atBottom = observed !== null && window.scrollY + window.innerHeight >= root.scrollHeight - 2;
		const id = atBottom ? lastId : observed;
		if (id !== shown) setCurrent((shown = id));
	}

	const observer = new IntersectionObserver(
		entries => {
			for (const entry of entries) {
				if (entry.isIntersecting) observed = entry.target.id === "top" ? null : entry.target.id;
			}
			update();
		},
		{ rootMargin: "-45% 0px -50% 0px" },
	);
	let frame = 0;
	window.addEventListener(
		"scroll",
		() => {
			if (!frame) frame = requestAnimationFrame(() => ((frame = 0), update()));
		},
		{ passive: true },
	);
	for (const id of ["top", ...links.map(link => link.dataset.section!)]) {
		const section = document.getElementById(id);
		if (section) observer.observe(section);
	}
	window.addEventListener("resize", moveIndicator);
	toggle.addEventListener("click", () => requestAnimationFrame(moveIndicator));
	document.fonts?.ready.then(moveIndicator);
</script>

<style>
	.site-nav {
		position: fixed;
		top: var(--space-4);
		left: var(--space-4);
		z-index: 20;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		transition: opacity 700ms ease;
	}

	ul {
		position: relative;
		display: flex;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-1);
		list-style: none;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(16, 16, 21, 0.9);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.indicator {
		position: absolute;
		top: 0;
		left: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.15);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
		opacity: 0;
		pointer-events: none;
		transition:
			transform 420ms cubic-bezier(0.65, 0, 0.25, 1),
			width 420ms cubic-bezier(0.65, 0, 0.25, 1),
			height 420ms cubic-bezier(0.65, 0, 0.25, 1),
			opacity 300ms ease;
	}

	.indicator.shown {
		opacity: 1;
	}

	a {
		position: relative;
		display: block;
		padding: 0.35em 0.85em;
		border-radius: 999px;
		color: #e4e1ec;
		text-decoration: none;
		white-space: nowrap;
	}

	a:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.08);
	}

	a.current {
		color: #fff;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		gap: var(--space-2);
		padding: 0.45em 0.9em;
		font: inherit;
		color: #e6e3ee;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(16, 16, 21, 0.9);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		cursor: pointer;
	}

	.nav-toggle svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	/* Hidden while the intro plays. */
	:global(html.intro:not(.intro-done)) .site-nav {
		opacity: 0;
		pointer-events: none;
	}

	.menu-theme-row {
		display: none;
	}

	.icon-close {
		display: none;
	}

	/* Phones: a menu button in the top-right corner (left of it, the sound
	   toggle) opens a full-screen menu. Without JavaScript the links simply
	   wrap across the top of the page. */
	@media (max-width: 760px) {
		.site-nav {
			right: var(--space-4);
		}

		ul {
			flex-wrap: wrap;
			border-radius: var(--radius-1);
		}

		.indicator {
			display: none;
		}

		:global(html.js) .site-nav {
			left: auto;
		}

		:global(html.js) .site-nav.open {
			z-index: 40;
		}

		:global(html.js) .nav-toggle {
			position: relative;
			z-index: 1;
			display: grid;
			place-items: center;
			width: 2.6rem;
			height: 2.6rem;
			padding: 0;
			border-radius: 50%;
		}

		.nav-toggle svg {
			width: 1.3rem;
			height: 1.3rem;
		}

		.nav-toggle[aria-expanded="true"] .icon-open {
			display: none;
		}

		.nav-toggle[aria-expanded="true"] .icon-close {
			display: block;
		}

		:global(html.js) ul {
			display: none;
		}

		:global(html.js) .site-nav.open ul {
			position: fixed;
			inset: 0;
			display: flex;
			flex-direction: column;
			flex-wrap: nowrap;
			justify-content: flex-end;
			gap: var(--space-1);
			padding: var(--space-8) var(--space-6) 14vh;
			border: 0;
			border-radius: 0;
			background: rgba(8, 8, 12, 0.94);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			overflow-y: auto;
			animation: menu-in 260ms ease-out;
		}

		:global(html.js) .site-nav.open a {
			display: inline-block;
			width: fit-content;
			padding: 0.2em 0;
			border-radius: 0;
			font-family: var(--font-display);
			font-size: clamp(1.9rem, 9vw, 2.6rem);
			line-height: 1.15;
			color: #b9b6c6;
			background: none;
		}

		:global(html.js) .site-nav.open a.current,
		:global(html.js) .site-nav.open a:hover,
		:global(html.js) .site-nav.open a:focus-visible {
			color: #fff;
		}

		:global(html.js) .site-nav.open a.current {
			text-decoration: underline;
			text-decoration-color: #ff4fae;
			text-decoration-thickness: 2px;
			text-underline-offset: 0.18em;
		}

		:global(html.js) .site-nav.open .menu-theme-row {
			display: block;
			margin-top: var(--space-6);
		}

		.menu-theme {
			font: inherit;
			font-size: 1rem;
			padding: 0.5em 1.1em;
			color: #e4e1ec;
			background: transparent;
			border: 1px solid rgba(255, 255, 255, 0.25);
			border-radius: 999px;
			cursor: pointer;
		}

		@keyframes menu-in {
			from {
				opacity: 0;
			}
		}
	}

	:global(html.menu-open) {
		overflow: hidden;
	}
</style>
