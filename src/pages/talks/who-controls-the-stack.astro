				.slide.is-active .tip,
				.slide-photo.is-active .photo {
					animation: none;
				}

				.draw {
					stroke-dashoffset: 0;
				}

				.slide {
					transition: opacity 0.4s;
				}

				.slide.is-leaving {
					animation: none;
					opacity: 0;
				}

				[data-step] {
					transform: none;
					transition: opacity 0.4s;
				}

				.blob,
				.progress span {
					transition: none;
				}
			}
		</style>
	</body>
</html>
