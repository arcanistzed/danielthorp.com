---
// A slide deck for projecting, not a page of the site: no nav, footer or sound.
// The stage is a fixed 1920 by 1080 canvas scaled to fit any screen, so the
// layout is the same on every projector. Right arrow or Space advances, left
// arrow goes back, F toggles full screen.
import { Font } from "astro:assets";
import "../../styles/tokens.css";
// My own photograph of the opening session, 23 June 2026.
import hall from "../../assets/talks/un-open-source-week.jpg";

const title = "Who controls the stack?";
const subtitle = "Open source, privacy and digital sovereignty";

---

<!doctype html>
<html lang="en-CA" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="description" content={`${subtitle}. Slides for a talk by Daniel Thorp.`} />
		<meta name="theme-color" content="#141416" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<Font cssVariable="--font-display" preload={[{ weight: 600, style: "normal", subset: "latin" }]} />
		<link rel="preload" as="image" href={hall.src} />
		<title>{title} · Daniel Thorp</title>
	</head>

	<body>
		<div class="backdrop" aria-hidden="true">
			<span class="weave"></span>
			<span class="blob blob-a"></span>
			<span class="blob blob-b"></span>
		</div>

		<main class="deck" id="deck" data-dir="forward">
			<!-- Title -->
			<section class="slide slide-title" aria-label="Title">
				<div class="cols cols-title">
					<div>
						<h1 data-a>{title}</h1>
						<p class="subtitle" data-a>{subtitle}</p>
						<p class="byline" data-a>Daniel Thorp</p>
					</div>
					<svg class="stack" viewBox="0 0 640 820" role="img" aria-label="A stack of five layers.">
						<defs>
							<linearGradient id="plate" x1="0" y1="0" x2="1" y2="1">
								<stop offset="0" stop-color="#8b7cf6" stop-opacity="0.55"></stop>
								<stop offset="1" stop-color="#d2847a" stop-opacity="0.35"></stop>
							</linearGradient>
						</defs>
						{
							[650, 525, 400, 275, 150]
								.map((cy) => (
									<g data-a="drop">
										<path
											class="plate-side"
											d={`M60,${cy} L320,${cy + 110} L580,${cy} L580,${cy + 30} L320,${cy + 140} L60,${cy + 30} Z`}
										/>
										<path
											class="plate-top"
											d={`M320,${cy - 110} L580,${cy} L320,${cy + 110} L60,${cy} Z`}
										/>
									</g>
								))
						}
					</svg>
				</div>
			</section>

			<!-- UN Open Source Week -->
			<section class="slide slide-photo" aria-label="UN Open Source Week">
				<img class="photo" src={hall.src} alt="A full conference chamber at United Nations headquarters, with a screen reading Welcome to Open Source Week." />
				<div class="photo-text">
					<p class="where" data-a>UN Open Source Week, New York, 23 to 25 June 2026</p>
					<h2 data-a>I went to New York with two questions.</h2>
					<ol class="asked">
						<li data-a>Can open source advance Canada's interests as a middle power?</li>
						<li data-a>Where is Canada on promoting it?</li>
					</ol>
					<p class="body" data-step="1">I came home with far more answers to the first than to the second.</p>
				</div>
			</section>

			<!-- One problem, three scales -->
			<section class="slide" aria-label="One problem at three scales">
				<div class="cols">
					<div>
						<h2 data-a>Privacy and sovereignty are one problem at different scales.</h2>
						<p class="body" data-step="1">
							Who controls it? Who can audit it? Who keeps it running when someone else changes the rules, and who
							pays to maintain it?
						</p>
					</div>
					<svg class="rings" viewBox="0 0 700 700" role="img" aria-label="Three nested circles: you, an institution, a country.">
						<circle class="ring draw" pathLength="1" cx="350" cy="370" r="315" style="--d: 0.9s"></circle>
						<circle class="ring draw" pathLength="1" cx="350" cy="370" r="210" style="--d: 0.6s"></circle>
						<circle class="ring ring-core draw" pathLength="1" cx="350" cy="370" r="105" style="--d: 0.3s"></circle>
						<text class="ring-label" x="350" y="382" data-a>You</text>
						<text class="ring-label" x="350" y="222" data-a>An institution</text>
						<text class="ring-label" x="350" y="116" data-a>A country</text>
					</svg>
				</div>
			</section>

			<!-- What FOSS gives you -->
			<section class="slide" aria-label="What open source gives you">
				<div class="cols">
					<div>
						<h2 data-a>Open source gives you options.</h2>
						<p class="body" data-a>
							Almost nobody reads the code. What matters is that someone can, and that anyone can patch it or fork it
							without asking the vendor.
						</p>
					</div>
					<svg class="loop" viewBox="0 0 760 700" role="img" aria-label="A cycle: inspect, adapt, fork or replace.">
						<path class="flow draw" pathLength="1" d="M478,196 Q600,280 606,412" style="--d: 0.7s"></path>
						<g transform="translate(606,412) rotate(87.4)"><path class="tip" d="M-24,-11 L0,0 L-24,11 Z" style="--d: 0.7s"></path></g>
						<path class="flow draw" pathLength="1" d="M498,566 Q380,622 262,566" style="--d: 1s"></path>
						<g transform="translate(262,566) rotate(205.4)"><path class="tip" d="M-24,-11 L0,0 L-24,11 Z" style="--d: 1s"></path></g>
						<path class="flow draw" pathLength="1" d="M154,412 Q160,280 282,196" style="--d: 1.3s"></path>
						<g transform="translate(282,196) rotate(-34.5)"><path class="tip" d="M-24,-11 L0,0 L-24,11 Z" style="--d: 1.3s"></path></g>
						<g data-a="pop">
							<circle class="node" cx="380" cy="130" r="104"></circle>
							<text class="node-label" x="380" y="143">Inspect</text>
						</g>
						<g data-a="pop">
							<circle class="node" cx="600" cy="520" r="104"></circle>
							<text class="node-label" x="600" y="533">Adapt</text>
						</g>
						<g data-a="pop">
							<circle class="node" cx="160" cy="520" r="104"></circle>
							<text class="node-label" x="160" y="533">Fork</text>
						</g>
					</svg>
				</div>
			</section>

			<!-- Signal: content and metadata -->
			<section class="slide" aria-label="Privacy and metadata">
				<h2 data-a>Privacy is what never gets collected.</h2>
				<svg class="wire" viewBox="0 0 1660 580" role="img" aria-label="Two phones exchange an end-to-end encrypted message through a service. Most services could keep the metadata. Signal is designed not to.">
					<path class="lane draw" pathLength="1" d="M210,170 H1450" style="--d: 0.7s"></path>
					<g data-a="pop">
						<rect class="device" x="60" y="40" width="150" height="270" rx="26"></rect>
						<line class="device-line" x1="110" y1="278" x2="160" y2="278"></line>
						<g class="lock" transform="translate(135,150)">
							<rect x="-17" y="0" width="34" height="27" rx="5"></rect>
							<path d="M-10,0 v-10 a10,10 0 0 1 20,0 v10"></path>
						</g>
						<text class="wire-small" x="135" y="356">holds a key</text>
					</g>
					<g data-a="pop">
						<rect class="server" x="700" y="70" width="260" height="200" rx="18"></rect>
						<line class="server-line" x1="730" y1="120" x2="930" y2="120"></line>
						<line class="server-line" x1="730" y1="220" x2="930" y2="220"></line>
						<text class="wire-label" x="830" y="182">The service</text>
					</g>
					<g data-a="pop">
						<rect class="device" x="1450" y="40" width="150" height="270" rx="26"></rect>
						<line class="device-line" x1="1500" y1="278" x2="1550" y2="278"></line>
						<g class="lock" transform="translate(1525,150)">
							<rect x="-17" y="0" width="34" height="27" rx="5"></rect>
							<path d="M-10,0 v-10 a10,10 0 0 1 20,0 v10"></path>
						</g>
						<text class="wire-small" x="1525" y="356">holds a key</text>
					</g>
					<text class="wire-cyan" x="455" y="140" data-a>Message content</text>
					<text class="wire-cyan" x="1205" y="140" data-a>encrypted end to end</text>
					<g data-step="1">
						<path class="leak draw" pathLength="1" d="M830,270 V392" style="--d: 0.15s"></path>
						<rect class="meta" x="360" y="392" width="940" height="168" rx="18"></rect>
						<text class="wire-rose" x="830" y="442">Metadata a messaging service could keep</text>
						<text class="wire-small wire-small-light" x="830" y="486">who you talk to, when, how often, which groups</text>
						<text class="wire-small wire-small-cyan" x="830" y="530">Signal is designed not to keep it</text>
					</g>
				</svg>
				<p class="note" data-step="2">
					Signal publishes its client and server code. Its published replies to government requests show how little
					it holds, such as when an account was created and when it last connected.
				</p>
			</section>

			<!-- Bill C-22 -->
			<section class="slide" aria-label="Bill C-22">
				<h2 data-a>Bill C-22 puts that design to the test.</h2>
				<div class="cols cols-wide-right">
					<div class="stat" data-a>
						<p class="stat-number">6 months</p>
						<p class="stat-label">is the longest that designated providers could be ordered to keep metadata</p>
					</div>
					<ol class="timeline" data-a>
						<li><span class="when">18 June 2026</span> Passed the House of Commons</li>
						<li><span class="when">22 October 2026</span> Referred to a Senate committee</li>
						<li class="open"><span class="when">10 November 2026</span> Not law</li>
					</ol>
				</div>
				<div class="cols cols-even" data-step="1">
					<p class="pair">
						<strong>The House added limits</strong> on compelled decryption and on building in systemic
						vulnerabilities.
					</p>
					<p class="pair">
						<strong>Signal says gaps remain.</strong> An order could add a hidden participant, or make it keep
						metadata it never held.
					</p>
				</div>
				<p class="question" data-step="2">Can a government make a private service stop being private?</p>
			</section>

			<!-- Sovereignty -->
			<section class="slide" aria-label="What sovereignty means">
				<h2 data-a>Sovereignty is being able to say no and keep running.</h2>
				<ul class="asks">
					<li data-a>
						<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="27" cy="27" r="17"></circle><path d="M40,40 L56,56"></path></svg>
						Can we audit it?
					</li>
					<li data-a>
						<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8,32 H54 M40,16 L56,32 L40,48"></path></svg>
						Can we move?
					</li>
					<li data-a>
						<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M44,8 a14,14 0 0 0 -13,19 L8,50 l6,6 23,-23 a14,14 0 0 0 19,-13 l-9,9 -8,-2 -2,-8 z"></path></svg>
						Can we maintain it?
					</li>
					<li data-a>
						<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32,6 V30 M18,14 a24,24 0 1 0 28,0"></path></svg>
						Can we keep operating if the vendor changes the terms?
					</li>
				</ul>
			</section>

			<!-- Schleswig-Holstein -->
			<section class="slide" aria-label="A government migration">
				<h2 data-a>One German state has already moved.</h2>
				<div class="cols cols-wide-left">
					<div class="stat stat-hero" data-a>
						<p class="stat-number"><span data-count="44000">44,000</span>+</p>
						<p class="stat-label">government mailboxes in Schleswig-Holstein now run on open source software</p>
					</div>
					<div class="stat-side">
						<div class="stat" data-a>
							<p class="stat-number stat-number-small">110 million</p>
							<p class="stat-label">emails and calendar entries carried over</p>
						</div>
						<div class="stat" data-a>
							<p class="stat-number stat-number-small">About 80%</p>
							<p class="stat-label">of its office suite ecosystem switched to LibreOffice</p>
						</div>
					</div>
				</div>
				<ul class="strip" data-step="1">
					<li><strong>Germany</strong> ZenDiS, openDesk, openCode, Sovereign Tech Agency</li>
					<li><strong>France</strong> DINUM and La Suite numérique</li>
					<li><strong>Switzerland</strong> Army Cyber Command is moving to openDesk. About 3,000 federal staff follow by 2027.</li>
					<li><strong>Estonia</strong> X-Road data exchange</li>
				</ul>
				<p class="note" data-a>
					European Commission Open Source Observatory, February 2026
				</p>
			</section>

			<!-- Canada and the CLOUD Act -->
			<section class="slide" aria-label="Canada and the CLOUD Act">
				<h2 data-a>A Canadian data centre is a location. Sovereignty is control.</h2>
				<svg class="reach" viewBox="0 0 1660 320" role="img" aria-label="A data centre in Canada run by a provider under United States law. A CLOUD Act demand to the provider reaches the data.">
					<path class="tie draw" pathLength="1" d="M560,220 H1100" style="--d: 0.6s"></path>
					<g data-a="pop">
						<rect class="box" x="40" y="140" width="520" height="160" rx="18"></rect>
						<text class="wire-label" x="300" y="232">Data centre in Canada</text>
					</g>
					<g data-a="pop">
						<rect class="box" x="1100" y="140" width="520" height="160" rx="18"></rect>
						<text class="wire-label" x="1360" y="232">Provider under US law</text>
					</g>
					<text class="wire-small" x="830" y="262" data-a>operated by</text>
					<g data-step="1">
						<path class="demand draw" pathLength="1" d="M1360,136 C1360,-10 300,-10 300,130" style="--d: 0.1s"></path>
						<g transform="translate(300,132) rotate(90)"><path class="tip tip-rose" d="M-24,-11 L0,0 L-24,11 Z" style="--d: 0.1s"></path></g>
						<text class="wire-rose" x="830" y="92">CLOUD Act demand</text>
					</g>
				</svg>
				<div class="cols cols-even" data-step="2">
					<p class="pair">
						<strong>Canada has the principles.</strong> Its Digital Standards say to work in the open by default
						and use open standards.
					</p>
					<p class="pair">
						<strong>Treasury Board white paper, 2018.</strong> As long as a cloud provider operating in Canada
						is subject to a foreign country's laws, Canada will not have full sovereignty over its data.
					</p>
				</div>
			</section>

			<!-- AI and maintainers -->
			<section class="slide" aria-label="AI and open source maintainers">
				<h2 data-a>AI made code cheap to write. Reviewing it costs what it always did.</h2>
				<div class="cols cols-even">
					<div class="stat" data-a>
						<p class="stat-number"><span data-count="25">25</span>%</p>
						<p class="stat-label">
							of incoming pull requests are low-quality AI output, by maintainers' own estimate. On large
							projects, 31%.
						</p>
					</div>
					<div class="stat" data-a>
						<p class="stat-number"><span data-count="64">64</span>%</p>
						<p class="stat-label">
							of maintainers on large projects say AI-assisted contributions have made review take longer
						</p>
					</div>
				</div>
				<ol class="chain" data-step="1">
					<li>Cheap to generate</li>
					<li>Costly to verify</li>
					<li>Burnout and slower patches</li>
				</ol>
				<p class="note" data-a>
					Linux Foundation Research, October 2026
				</p>
			</section>

			<!-- The right to install -->
			<section class="slide" aria-label="The right to install">
				<div class="cols cols-wide-left">
					<div>
						<h2 data-a>Being able to read the code is worth less if you can't run it.</h2>
						<p class="body" data-a>
							In September 2026 Google began enforcing developer verification on certified Android devices in
							Brazil, Indonesia, Singapore and Thailand. The rest of the world is planned for 2027. Where it
							applies, an unregistered app needs developer options, a restart, a confirmation and a
							24&#8209;hour wait, or ADB.
						</p>
						<p class="caveat" data-step="1">
							A system you can't inspect, modify or leave puts the platform in charge, not you.
						</p>
					</div>
					<svg class="phone" viewBox="0 0 420 640" role="img" aria-label="A phone showing a clock and a 24-hour wait.">
						<rect class="device" x="60" y="20" width="300" height="600" rx="44" data-a="pop"></rect>
						<circle class="clock draw" pathLength="1" cx="210" cy="270" r="96" style="--d: 0.8s"></circle>
						<path class="clock-hand draw" pathLength="1" d="M210,270 V206 M210,270 L252,296" style="--d: 1.3s"></path>
						<text class="phone-label" x="210" y="452" data-a>24 h</text>
						<line class="device-line" x1="170" y1="578" x2="250" y2="578"></line>
					</svg>
				</div>
				<ol class="history" data-step="2">
					<li><span class="when">2010</span> Openness proposed as a principle of Canada's digital strategy</li>
					<li><span class="when">2024</span> Repair and interoperability exceptions become law</li>
					<li><span class="when">2026</span> Encryption and app installation are still contested</li>
				</ol>
			</section>

			<!-- Policy -->
			<section class="slide" aria-label="What Canada could do">
				<h2 data-a>What I came back thinking Canada needs to do.</h2>
				<ol class="agenda">
					<li data-a>
						<h3>Show up</h3>
						<p>
							Take a seat where open source and AI are governed, and listen to the countries that have dealt
							with this for longer.
						</p>
					</li>
					<li data-a>
						<h3>Coordinate</h3>
						<p>
							Formalise a cross-government open source programme office, with a say in procurement and a way for
							public servants to contribute upstream.
						</p>
					</li>
					<li data-a>
						<h3>Sustain</h3>
						<p>Pay the maintainers of the upstream projects that public services already depend on.</p>
					</li>
					<li data-a>
						<h3>Keep the exits open</h3>
						<p>Protect interoperability, strong encryption and the right to install software on a device you own.</p>
					</li>
				</ol>
			</section>

			<!-- Close -->
			<section class="slide slide-close" aria-label="Closing">
				<p class="closing" data-a>We can't be part of the conversation if we aren't sitting at the table.</p>
				<p class="body" data-step="1">
					Where you can start: reproduce a bug, write the test, and stay for the maintenance.
				</p>
				<p class="thanks" data-a>Thank you.</p>
			</section>

			<div class="progress" aria-hidden="true"><span id="bar"></span></div>
			<p class="counter" id="counter" aria-live="polite"></p>
		</main>

		<script>
			const deck = document.getElementById("deck") as HTMLElement;
			const slides = Array.from(deck.querySelectorAll<HTMLElement>(".slide"));
			const bar = document.getElementById("bar") as HTMLElement;
			const counter = document.getElementById("counter") as HTMLElement;
			const still = matchMedia("(prefers-reduced-motion: reduce)");

			// Entrance order within a slide follows the markup.
			for (const slide of slides) {
				slide.querySelectorAll<HTMLElement | SVGElement>("[data-a]").forEach((el, i) => {
					el.style.setProperty("--i", String(i));
				});
			}

			const stepsOf = (slide: HTMLElement) =>
				Math.max(0, ...Array.from(slide.querySelectorAll<HTMLElement>("[data-step]"), (el) => Number(el.dataset.step)));

			let index = 0;
			let step = 0;
			let leaving: HTMLElement | null = null;
			let leaveTimer = 0;

			function showSteps() {
				slides[index].querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
					el.classList.toggle("on", Number(el.dataset.step) <= step);
				});
			}

			function countUp(slide: HTMLElement) {
				slide.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
					const target = Number(el.dataset.count);
					const show = (n: number) => (el.textContent = Math.round(n).toLocaleString("en-CA"));
					if (still.matches) return show(target);
					const start = performance.now() + 350;
					const tick = (now: number) => {
						if (!slide.classList.contains("is-active")) return show(target);
						const t = Math.min(1, Math.max(0, (now - start) / 1300));
						show(target * (1 - Math.pow(1 - t, 4)));
						if (t < 1) requestAnimationFrame(tick);
					};
					show(0);
					requestAnimationFrame(tick);
				});
			}

			function paint() {
				const last = slides.length - 1;
				bar.style.transform = `scaleX(${index / last})`;
				counter.textContent = `${index + 1} / ${slides.length}`;
				document.documentElement.style.setProperty("--p", String(index / last));
				history.replaceState(null, "", `#${index + 1}`);
			}

			function go(to: number, toStep: number) {
				if (to < 0 || to >= slides.length || to === index) return;
				// A slide still on its way out is cut short, so fast key presses
				// never leave two slides fading at once.
				clearTimeout(leaveTimer);
				leaving?.classList.remove("is-leaving");

				deck.dataset.dir = to > index ? "forward" : "back";
				leaving = slides[index];
				leaving.classList.remove("is-active");
				leaving.classList.add("is-leaving");
				const done = leaving;
				leaveTimer = window.setTimeout(() => {
					done.classList.remove("is-leaving");
					if (leaving === done) leaving = null;
				}, 700);

				index = to;
				step = toStep;
				// Set the arriving slide's build state before it shows, without the
				// step transition, so pieces from an earlier visit never fade out.
				slides[index].classList.add("snap");
				showSteps();
				void slides[index].offsetWidth;
				slides[index].classList.remove("snap");
				slides[index].classList.remove("is-leaving");
				slides[index].classList.add("is-active");
				showSteps();
				countUp(slides[index]);
				paint();
			}

			function next() {
				if (step < stepsOf(slides[index])) {
					step += 1;
					showSteps();
				} else {
					go(index + 1, 0);
				}
			}

			// Going back lands on the previous slide fully built.
			function back() {
				if (step > 0) {
					step -= 1;
					showSteps();
				} else if (index > 0) {
					go(index - 1, stepsOf(slides[index - 1]));
				}
			}

			addEventListener("keydown", (event) => {
				if (event.ctrlKey || event.metaKey || event.altKey) return;
				const key = event.key;
