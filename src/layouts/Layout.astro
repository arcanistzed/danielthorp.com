---
import Footer from "../components/Footer.astro";
import SoundToggle from "../components/home/SoundToggle.astro";
import ThemeToggle from "../components/home/ThemeToggle.astro";
import { description as defaultDescription } from "../data/site";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
	title?: string;
	description?: string;
}

const site = "https://danielthorp.com";

const { title, description = defaultDescription } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site);
const pageTitle = title ? `${title} · Daniel Thorp` : "Daniel Thorp";
const isHome = Astro.url.pathname === "/";
const ogImageAlt =
	"A card reading “Hello! My name is” and “Bonjour! Je m’appelle” above the name Daniel Thorp.";

const person = {
	"@type": "Person",
	"@id": `${site}/#person`,
	name: "Daniel Thorp",
	givenName: "Daniel",
	familyName: "Thorp",
	url: `${site}/`,
	email: "daniel@danielthorp.com",
	image: {
		"@type": "ImageObject",
		url: `${site}/daniel-thorp.jpg`,
		width: 800,
		height: 800,
		caption: "Daniel Thorp",
	},
	description: defaultDescription,
	jobTitle: "Software Engineering Student",
	knowsLanguage: ["en", "fr"],
	nationality: { "@type": "Country", name: "Canada" },
	homeLocation: {
		"@type": "Place",
		name: "Ottawa, Ontario, Canada",
		address: {
			"@type": "PostalAddress",
			addressLocality: "Ottawa",
			addressRegion: "ON",
			addressCountry: "CA",
		},
	},
	// Topics the page itself backs up: roles, projects, and writing.
	knowsAbout: [
		"Software engineering",
		"Full-stack web development",
		"DevOps and deployment automation",
		"Open-source software",
		"Civic technology",
		"Technology policy",
		"AI governance",
		"Digital rights",
		"Nonprofit governance",
		"Student government",
		"Hackathon organizing",
	],
	affiliation: [
		{
			"@type": "CollegeOrUniversity",
			name: "University of Ottawa",
			url: "https://www.uottawa.ca/",
		},
		{
			"@type": "ResearchOrganization",
			name: "Canadian Robotics and Artificial Intelligence Ethical Design Lab",
			alternateName: "CRAIEDL",
			url: "https://www.craiedl.ca/",
		},
	],
	memberOf: [
		{
			"@type": "Organization",
			name: "OpenMedia",
			url: "https://openmedia.org/",
		},
		{
			"@type": "Organization",
			name: "Capital Technology Network",
			url: "https://hackthehill.com/",
		},
		{
			"@type": "Organization",
			name: "uOttawa Digital Policy Association",
			url: "https://uodpa-apnuo.org/",
		},
	],
	sameAs: [
		"https://github.com/arcanistzed",
		"https://www.linkedin.com/in/daniel-a-thorp/",
		"https://arcanistzed.substack.com",
		"https://bsky.app/profile/danielthorp.bsky.social",
		"https://x.com/arcanistzed",
		"https://instagram.com/daniel.a.thorp",
	],
};

// One graph: the site, the person it's about, and on the home page a
// ProfilePage whose main entity is that person.
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${site}/#website`,
			name: "Daniel Thorp",
			url: `${site}/`,
			inLanguage: "en-CA",
			author: { "@id": person["@id"] },
			publisher: { "@id": person["@id"] },
		},
		person,
		...(isHome
			? [
					{
						"@type": "ProfilePage",
						"@id": `${site}/#profile`,
						url: `${site}/`,
						name: pageTitle,
						inLanguage: "en-CA",
						isPartOf: { "@id": `${site}/#website` },
						mainEntity: { "@id": person["@id"] },
						about: { "@id": person["@id"] },
					},
				]
			: []),
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content="Daniel Thorp" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Daniel Thorp" />
		<meta property="og:locale" content="en_CA" />
		<meta property="og:locale:alternate" content="fr_CA" />
		<meta
			property="og:image"
			content="https://danielthorp.com/og-image.png"
		/>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content="https://danielthorp.com/og-image.png"
		/>
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Daniel Thorp"
			href="https://arcanistzed.substack.com/feed"
		/>

		<!-- Theme color -->
		<meta
			name="theme-color"
			content="#0a0b0d"
			media="(prefers-color-scheme: dark)"
		/>
		<meta
			name="theme-color"
			content="#ffffff"
			media="(prefers-color-scheme: light)"
		/>

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<title>{pageTitle}</title>

		<!-- Decide before first paint whether the home page intro will play. -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add("js");
				let seen = false;
				try {
					seen = sessionStorage.getItem("intro-played") === "1";
				} catch {}
				const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (!seen && !still) root.classList.add("intro");
			})();
		</script>
	</head>

	<body>
		<!-- Page navigation goes first so it leads the tab order. -->
		<slot name="nav" />
		<ThemeToggle />
		<SoundToggle />
		<main id="content">
			<slot />
		</main>

		<Footer />

		<script>
			import { installInteractionSounds } from "../scripts/interactions";

			installInteractionSounds();
		</script>
	</body>
</html>
