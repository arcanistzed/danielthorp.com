---
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Daniel Thorp",
	description = "Daniel Thorp is a final-year Software Engineering student at the University of Ottawa who works on AI ethics research, digital rights, and technology policy.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://danielthorp.com");
const pageTitle = title === "Daniel Thorp" ? title : `${title} · Daniel Thorp`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content="Daniel Thorp" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Daniel Thorp" />
		<meta
			property="og:image"
			content="https://danielthorp.com/og-image.png"
		/>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content="https://danielthorp.com/og-image.png"
		/>

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Daniel Thorp"
			href="https://arcanistzed.substack.com/feed"
		/>

		<!-- Theme color -->
		<meta
			name="theme-color"
			content="#0a0b0d"
			media="(prefers-color-scheme: dark)"
		/>
		<meta
			name="theme-color"
			content="#ffffff"
			media="(prefers-color-scheme: light)"
		/>

		<!-- Structured data -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: "Daniel Thorp",
				url: "https://danielthorp.com",
				author: {
					"@type": "Person",
					name: "Daniel Thorp",
					url: "https://danielthorp.com",
					email: "daniel@danielthorp.com",
					jobTitle: "Software Engineering Student",
					affiliation: [
						{
							"@type": "CollegeOrUniversity",
							name: "University of Ottawa",
							url: "https://www.uottawa.ca/",
						},
						{
							"@type": "ResearchOrganization",
							name: "Canadian Robotics and Artificial Intelligence Ethical Design Lab",
							alternateName: "CRAIEDL",
							url: "https://www.craiedl.ca/",
						},
					],
					memberOf: [
						{
							"@type": "Organization",
							name: "OpenMedia",
							url: "https://openmedia.org/",
						},
						{
							"@type": "Organization",
							name: "Capital Technology Network",
							url: "https://hackthehill.com/",
						},
						{
							"@type": "Organization",
							name: "uOttawa Digital Policy Association",
							url: "https://uodpa-apnuo.org/",
						},
					],
					sameAs: [
						"https://github.com/arcanistzed",
						"https://www.linkedin.com/in/daniel-a-thorp/",
						"https://arcanistzed.substack.com",
						"https://bsky.app/profile/danielthorp.bsky.social",
						"https://instagram.com/daniel.a.thorp",
					],
				},
			})}
		/>

		<title>{pageTitle}</title>

		<!-- Decide before first paint whether the home page intro will play. -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add("js");
				let seen = false;
				try {
					seen = sessionStorage.getItem("intro-played") === "1";
				} catch {}
				const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (!seen && !still) root.classList.add("intro");
			})();
		</script>
	</head>

	<body>
		<main id="content">
			<slot />
		</main>

		<Footer />
	</body>
</html>
